# analyzer — per-service environment configuration.
#
# Copy to .env and fill in. Loaded automatically on `serve` via godotenv.
# Values here OVERRIDE the baked YAML (config/*.yaml); secrets live here only,
# never in committed YAML. On a deploy target that only accepts env vars
# (e.g. Timeweb App Platform) these keys can drive the entire config.

# --- Database ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=pguser          # secret
DB_PASSWORD=pgpassword  # secret
DB_NAME=jira_tracker
DB_SSLMODE=disable      # disable | require | verify-ca | verify-full

# --- App ---
LOG_LEVEL=info          # debug | info | warn | error

# --- Metrics ---
METRICS_PORT=9090
